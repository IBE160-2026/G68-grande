# Innstillinger for Søknadsassistenten.
# Filen er valgfri: nettsiden starter uten .env.
# Vil du bruke den, kopier filen til backend/.env og fyll inn verdier der.
# Skriv aldri ekte verdier i denne filen.

# Nøkkel til Claude API. Tom = bare testmodus.
ANTHROPIC_API_KEY=

# Claude-modellen. Tom = claude-opus-5-5.
ANTHROPIC_MODEL=

# Nøkkel som signerer innloggingen. Tom = en tilfeldig lages ved hver oppstart.
SECRET_KEY=
